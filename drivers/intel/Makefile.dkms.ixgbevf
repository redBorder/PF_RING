all: install

add: veryclean
	\/bin/rm -rf /usr/src/ixgbevf-zc-4.5.1.6282
	mkdir /usr/src/ixgbevf-zc-4.5.1.6282
	cd ixgbevf/ixgbevf-4.5.1-zc/src ; make clean; cp -r * /usr/src/ixgbevf-zc-4.5.1.6282
	cp ../../kernel/linux/pf_ring.h /usr/src/ixgbevf-zc-4.5.1.6282
	sed -i -e 's/ixgbevf\.o/ixgbevf_zc.o/' -e 's/ixgbevf-/ixgbevf_zc-/' /usr/src/ixgbevf-zc-4.5.1.6282/Kbuild
	mv /usr/src/ixgbevf-zc-4.5.1.6282/Kbuild /usr/src/ixgbevf-zc-4.5.1.6282/Makefile
	sed -i '1iPF_RING_PATH=\/usr\/src\/pfring-8.6.0.6282' /usr/src/ixgbevf-zc-4.5.1.6282/Makefile
	cp dkms.conf.ixgbevf /usr/src/ixgbevf-zc-4.5.1.6282/dkms.conf 
	dkms add -m ixgbevf-zc -v 4.5.1.6282

build: add
	dkms build -m ixgbevf-zc -v 4.5.1.6282

install: build
	dkms install --force -m ixgbevf-zc -v 4.5.1.6282

deb: add add_deb install
	dkms mkdeb -m ixgbevf-zc -v 4.5.1.6282 --source-only

rpm: add add_rpm install
	dkms mkrpm -m ixgbevf-zc -v 4.5.1.6282 --source-only

add_rpm:
	cp -f zc.spec /usr/src/ixgbevf-zc-4.5.1.6282/ixgbevf-zc-dkms-mkrpm.spec

add_deb:
	cp -r zc-dkms-mkdeb /usr/src/ixgbevf-zc-4.5.1.6282/ixgbevf-zc-dkms-mkdeb

remove:
	-dkms remove -m ixgbevf-zc -v 4.5.1.6282 --all
	\/bin/rm -f /lib/modules/*/weak-updates/ixgbevf*ko
	\/bin/rm -f /lib/modules/*/extra/ixgbevf*ko
	\/bin/rm -rf /var/lib/dkms/ixgbevf-zc

veryclean: remove
	\/bin/rm -fr /usr/src/ixgbevf-zc-4.5.1.6282
	
