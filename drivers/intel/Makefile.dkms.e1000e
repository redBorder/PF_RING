all: install

add: veryclean
	\/bin/rm -rf /usr/src/e1000e-zc-3.8.7.6282
	mkdir /usr/src/e1000e-zc-3.8.7.6282
	cd e1000e/e1000e-3.8.7-zc/src ; make clean; cp -r * /usr/src/e1000e-zc-3.8.7.6282
	cp ../../kernel/linux/pf_ring.h /usr/src/e1000e-zc-3.8.7.6282
	sed -i -e 's/e1000e\.o/e1000e_zc.o/' -e 's/e1000e-/e1000e_zc-/' /usr/src/e1000e-zc-3.8.7.6282/Kbuild
	mv /usr/src/e1000e-zc-3.8.7.6282/Kbuild /usr/src/e1000e-zc-3.8.7.6282/Makefile
	sed -i '1iPF_RING_PATH=\/usr\/src\/pfring-8.6.0.6282' /usr/src/e1000e-zc-3.8.7.6282/Makefile
	cp dkms.conf.e1000e /usr/src/e1000e-zc-3.8.7.6282/dkms.conf
	dkms add -m e1000e-zc -v 3.8.7.6282

build: add
	dkms build -m e1000e-zc -v 3.8.7.6282

install: build
	dkms install --force -m e1000e-zc -v 3.8.7.6282

deb: add add_deb install
	dkms mkdeb -m e1000e-zc -v 3.8.7.6282 --source-only

rpm: add add_rpm install
	dkms mkrpm -m e1000e-zc -v 3.8.7.6282 --source-only

add_rpm:
	cp -f zc.spec /usr/src/e1000e-zc-3.8.7.6282/e1000e-zc-dkms-mkrpm.spec

add_deb:
	cp -r zc-dkms-mkdeb /usr/src/e1000e-zc-3.8.7.6282/e1000e-zc-dkms-mkdeb

remove:
	-dkms remove -m e1000e-zc -v 3.8.7.6282 --all
	\/bin/rm -f /lib/modules/*/weak-updates/e1000e*ko
	\/bin/rm -f /lib/modules/*/extra/e1000e*ko
	\/bin/rm -rf /var/lib/dkms/e1000e-zc

veryclean: remove
	\/bin/rm -fr /usr/src/e1000e-zc-3.8.7.6282
	
