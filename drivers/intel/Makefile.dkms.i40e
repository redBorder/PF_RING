all: install

add: veryclean
	\/bin/rm -rf /usr/src/i40e-zc-2.17.4.6282
	mkdir -p /usr/src/i40e-zc-2.17.4.6282/
	cd i40e/i40e-2.17.4-zc/src/ ; make clean; cp -r * /usr/src/i40e-zc-2.17.4.6282/
	cp ../../kernel/linux/pf_ring.h /usr/src/i40e-zc-2.17.4.6282/
	sed -i -e 's/i40e\.o/i40e_zc.o/' -e 's/i40e-/i40e_zc-/' /usr/src/i40e-zc-2.17.4.6282/Kbuild
	mv /usr/src/i40e-zc-2.17.4.6282/Kbuild /usr/src/i40e-zc-2.17.4.6282/Makefile
	sed -i '1iPF_RING_PATH=\/usr\/src\/pfring-8.6.0.6282' /usr/src/i40e-zc-2.17.4.6282/Makefile
	cp dkms.conf.i40e /usr/src/i40e-zc-2.17.4.6282/dkms.conf 
	dkms add -m i40e-zc -v 2.17.4.6282

build: add
	dkms build -m i40e-zc -v 2.17.4.6282

install: build
	dkms install --force -m i40e-zc -v 2.17.4.6282

deb: add add_deb install
	dkms mkdeb -m i40e-zc -v 2.17.4.6282 --source-only

rpm: add add_rpm install
	dkms mkrpm -m i40e-zc -v 2.17.4.6282 --source-only

add_rpm:
	cp -f zc.spec /usr/src/i40e-zc-2.17.4.6282/i40e-zc-dkms-mkrpm.spec

add_deb:
	cp -r zc-dkms-mkdeb /usr/src/i40e-zc-2.17.4.6282/i40e-zc-dkms-mkdeb
	-cd  /usr/src/i40e-zc-2.17.4.6282/i40e-zc-dkms-mkdeb ; find . -type d -name ".git" -exec rm -fr {} \;

remove:
	-dkms remove -m i40e-zc -v 2.17.4.6282 --all
	\/bin/rm -f /lib/modules/*/weak-updates/i40e*ko
	\/bin/rm -f /lib/modules/*/extra/i40e*ko
	\/bin/rm -rf /var/lib/dkms/i40e-zc

veryclean: remove
	\/bin/rm -fr /usr/src/i40e-zc-2.17.4.6282
	
