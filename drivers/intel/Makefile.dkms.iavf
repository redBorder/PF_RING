all: install

add: veryclean
	\/bin/rm -rf /usr/src/iavf-zc-4.5.3.6281
	mkdir -p /usr/src/iavf-zc-4.5.3.6281/
	cd iavf/iavf-4.5.3-zc/src/ ; make clean; cp -r * /usr/src/iavf-zc-4.5.3.6281/
	cp ../../kernel/linux/pf_ring.h /usr/src/iavf-zc-4.5.3.6281/
	sed -i -e 's/iavf\.o/iavf_zc.o/' -e 's/iavf-/iavf_zc-/' /usr/src/iavf-zc-4.5.3.6281/Kbuild
	mv /usr/src/iavf-zc-4.5.3.6281/Kbuild /usr/src/iavf-zc-4.5.3.6281/Makefile
	sed -i '1iPF_RING_PATH=\/usr\/src\/pfring-8.6.0.6281' /usr/src/iavf-zc-4.5.3.6281/Makefile
	cp dkms.conf.iavf /usr/src/iavf-zc-4.5.3.6281/dkms.conf 
	dkms add -m iavf-zc -v 4.5.3.6281

build: add
	dkms build -m iavf-zc -v 4.5.3.6281

install: build
	dkms install --force -m iavf-zc -v 4.5.3.6281

deb: add add_deb install
	dkms mkdeb -m iavf-zc -v 4.5.3.6281 --source-only

rpm: add add_rpm install
	dkms mkrpm -m iavf-zc -v 4.5.3.6281 --source-only

add_rpm:
	cp -f zc.spec /usr/src/iavf-zc-4.5.3.6281/iavf-zc-dkms-mkrpm.spec

add_deb:
	cp -r zc-dkms-mkdeb /usr/src/iavf-zc-4.5.3.6281/iavf-zc-dkms-mkdeb
	-cd  /usr/src/iavf-zc-4.5.3.6281/iavf-zc-dkms-mkdeb ; find . -type d -name ".git" -exec rm -fr {} \;

remove:
	-dkms remove -m iavf-zc -v 4.5.3.6281 --all
	\/bin/rm -f /lib/modules/*/weak-updates/iavf*ko
	\/bin/rm -f /lib/modules/*/extra/iavf*ko
	\/bin/rm -rf /var/lib/dkms/iavf-zc

veryclean: remove
	\/bin/rm -fr /usr/src/iavf-zc-4.5.3.6281
	
