all: install

add: veryclean
	\/bin/rm -rf /usr/src/ixgbe-zc-5.5.3.6282
	mkdir /usr/src/ixgbe-zc-5.5.3.6282
	cd ixgbe/ixgbe-5.5.3-zc/src ; make clean; cp -r * /usr/src/ixgbe-zc-5.5.3.6282
	cp ../../kernel/linux/pf_ring.h /usr/src/ixgbe-zc-5.5.3.6282
	sed -i -e 's/ixgbe\.o/ixgbe_zc.o/' -e 's/ixgbe-/ixgbe_zc-/' /usr/src/ixgbe-zc-5.5.3.6282/Kbuild
	mv /usr/src/ixgbe-zc-5.5.3.6282/Kbuild /usr/src/ixgbe-zc-5.5.3.6282/Makefile
	sed -i '1iPF_RING_PATH=\/usr\/src\/pfring-8.6.0.6282' /usr/src/ixgbe-zc-5.5.3.6282/Makefile
	cp dkms.conf.ixgbe /usr/src/ixgbe-zc-5.5.3.6282/dkms.conf 
	dkms add -m ixgbe-zc -v 5.5.3.6282

build: add
	dkms build -m ixgbe-zc -v 5.5.3.6282

install: build
	dkms install --force -m ixgbe-zc -v 5.5.3.6282

deb: add add_deb install
	dkms mkdeb -m ixgbe-zc -v 5.5.3.6282 --source-only

rpm: add add_rpm install
	dkms mkrpm -m ixgbe-zc -v 5.5.3.6282 --source-only

add_rpm:
	cp -f zc.spec /usr/src/ixgbe-zc-5.5.3.6282/ixgbe-zc-dkms-mkrpm.spec

add_deb:
	cp -r zc-dkms-mkdeb /usr/src/ixgbe-zc-5.5.3.6282/ixgbe-zc-dkms-mkdeb

remove:
	-dkms remove -m ixgbe-zc -v 5.5.3.6282 --all
	\/bin/rm -f /lib/modules/*/weak-updates/ixgbe*ko
	\/bin/rm -f /lib/modules/*/extra/ixgbe*ko
	\/bin/rm -rf /var/lib/dkms/ixgbe-zc

veryclean: remove
	\/bin/rm -fr /usr/src/ixgbe-zc-5.5.3.6282
	
